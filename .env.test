# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# CurrentStateResolver now always attempts a live phone read first (see
# App\Service\CurrentState\CurrentStateResolver). Point it at a port
# nothing listens on so a real container-driven test (e.g.
# CurrentStateControllerTest) fails instantly ("connection refused") — the
# real .env value (a tailnet address) would otherwise hang for the full
# 10s SnapshotClient timeout since it's unreachable from a test run.
PHONE_BACKDOOR_URL=http://127.0.0.1:1

###> doctrine/doctrine-bundle ###
# Tests deliberately stay on SQLite (see .env.dev.local) — set explicitly
# here so they don't silently inherit .env's placeholder DATABASE_URL.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
###< doctrine/doctrine-bundle ###
