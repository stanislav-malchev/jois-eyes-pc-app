{% extends ea is defined and ea is not null ? ea.templatePath('layout') : '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ dateDisplayString }}{% endblock %}

{% block page_actions %}
    {% if ea is not null %}
        <div class="btn-group me-2" role="group">
            <a href="{{ path('admin_heart_rate', {date: prevDate, view: currentView}) }}" class="btn btn-secondary">
                <i class="fa fa-chevron-left"></i>
            </a>
            <input type="date" value="{{ currentDate }}"
                   class="btn btn-secondary text-white"
                   onchange="window.location.href='{{ path('admin_heart_rate', {view: currentView}) }}&date=' + this.value"
                   style="border-radius: 0; border-left: 1px solid rgba(255,255,255,0.1); border-right: 1px solid rgba(255,255,255,0.1);">
            <a href="{{ path('admin_heart_rate', {date: nextDate, view: currentView}) }}" class="btn btn-secondary">
                <i class="fa fa-chevron-right"></i>
            </a>
        </div>

        <div class="btn-group" role="group">
            <a href="{{ path('admin_heart_rate', {date: currentDate, view: 'D'}) }}"
               class="btn {{ currentView == 'D' ? 'btn-primary' : 'btn-secondary' }}">D</a>
            <a href="{{ path('admin_heart_rate', {date: currentDate, view: 'W'}) }}"
               class="btn {{ currentView == 'W' ? 'btn-primary' : 'btn-secondary' }}">W</a>
            <a href="{{ path('admin_heart_rate', {date: currentDate, view: 'M'}) }}"
               class="btn {{ currentView == 'M' ? 'btn-primary' : 'btn-secondary' }}">M</a>
        </div>
    {% endif %}
{% endblock %}

{% block main %}
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card card-body text-center">
                <div class="h5 text-muted">Range (Min - Max)</div>
                <div class="h2">{{ metrics.min }} - {{ metrics.max }} <small>BPM</small></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-body text-center">
                <div class="h5 text-muted">Average BPM</div>
                <div class="h2">{{ metrics.average }} <small>BPM</small></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-body text-center">
                <div class="h5 text-muted">Latest Reading</div>
                <div class="h2">{{ metrics.latest }} <small>BPM</small></div>
            </div>
        </div>
    </div>

    <div class="card card-body">
        <div class="h5 text-muted mb-3">Heart Rate Trend</div>
        <div style="height: 400px; position: relative;">
            <canvas id="heartRateChart"></canvas>
            {% if chartData is empty %}
                <div class="position-absolute top-50 start-50 translate-middle text-muted">
                    No data available for this period.
                </div>
            {% endif %}
        </div>
    </div>

    {# Structured data for possible JS integration #}
    <script id="chart-data" type="application/json">
        {{ chartData|json_encode|raw }}
    </script>
{% endblock %}
