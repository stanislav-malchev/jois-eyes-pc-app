{% extends ea is defined and ea is not null ? ea.templatePath('layout') : '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Current State (The Watcher){% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_current_state') }}" class="btn btn-primary">
        <i class="fa fa-rotate-right"></i> Poll again
    </a>
{% endblock %}

{% block main %}
    <p class="text-muted">
        Exactly what the <code>current-state</code> MCP tool and <code>GET /api/v1/current-state</code>
        return — the same live poll of the phone, the same decorations added on top, the same JSON.
        If you ask your agent "what do you see?", this is the document she's reading.
    </p>

    <div class="row mb-3">
        <div class="col-md-6">
            <div class="card card-body text-center">
                <div class="h5 text-muted">Verdict</div>
                <div class="h2">{{ verdict }}</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card card-body text-center">
                <div class="h5 text-muted">Server Time</div>
                <div class="h2">{{ serverTime }}</div>
            </div>
        </div>
    </div>

    <div class="card card-body">
        <div class="h5 text-muted mb-3">Raw response</div>
        <pre style="max-height: 70vh; overflow: auto; background: #1e1e1e; color: #d4d4d4; padding: 1rem; border-radius: 4px; white-space: pre-wrap;">{{ json }}</pre>
    </div>
{% endblock %}
